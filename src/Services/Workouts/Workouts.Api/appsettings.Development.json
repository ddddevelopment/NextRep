{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Workouts.Api"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=postgres;Port=5432;Database=workoutsdb;Username=postgres;Password=root;"
  },
  "Jwt": {
    "Key": "yJ4BhCnlX8SmVZfY3GhwVPK6QzLpR1Tt2N7EuDaI",
    "Issuer": "NextRep.Auth",
    "Audience": "NextRep.Auth",
    "AccessTokenExpirationMinutes": 10,
    "RefreshTokenExpirationMinutes": 60
  },
  "Jaeger": {
    "Uri": "http://jaeger:4317"
  }
}